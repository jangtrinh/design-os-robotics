# macOS & Python
.DS_Store
__pycache__/
*.py[cod]
.venv/
.env
.env.*

# Private device profiles, NVS dumps, runtime SQLite DBs & third-party reference snapshots
reference/
profiles/robot-*/
profiles/*/full-flash-*.bin
profiles/*/nvs-*.bin
profiles/*/partitions/*.bin
profiles/*/*.db*
*.db
*.db-shm
*.db-wal

# Large unmodified binary dumps
profiles/*/unpacked-assets/*.bin
profiles/*/unpacked-assets/*.raw
profiles/*/unpacked-assets/emoji_*.gif
# Theme images are built locally (tools/cook-procedural-avatar.py) from the user's own device dump; not tracked
themes/*.bin
themes/*-preview/

# Raw extracted firmware audio & personal voice samples
voices/extracted-firmware-ogg/*.ogg
voices/golden-reference/*.wav
voices/golden-reference/*elevenlabs*
